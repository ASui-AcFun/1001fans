5ff6b559571cf5f5d3b120"},"text":"[emot=acfun,1687/]我们是个很小的公司，虽然百分之九十九阿苇估计看不上我们，但我们愿意为阿苇留个岗位。","time":1627833706153,"floor":175,"likes":308,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":[],"reportedReplies":12,"hot":true,"replyPreview":[{"id":"472277580","root":"472276398","user":{"id":"382594","name":"扶香","avatar":"c0f90d971aaca772d661c7f2"},"text":"尽力便可，不要勉强。C137的开水永远流动在我们的耳膜上","time":1627833859358,"floor":1,"likes":10,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":[],"reportedReplies":0,"hot":false},{"id":"472279335","root":"472276398","user":{"id":"400279","name":"明天的明天是后天","avatar":"1fded3ec9edf457ada211cd4"},"text":"新的船驾驶远航，船上没有阿苇船长，只有再见和再见[emot=acfun,1665/]","time":1627834090798,"floor":1,"likes":12,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":[],"reportedReplies":0,"hot":false},{"id":"472279509","root":"472276398","user":{"id":"3584861","name":"原地自爆大师","avatar":"565ff6b559571cf5f5d3b120"},"text":"不不不，我还是挺认真的。","time":1627834112592,"floor":1,"likes":11,"isUp":false,"replyTo":"明天的明天是后天","replyToUserId":"400279","parentCommentId":null,"images":[],"reportedReplies":0,"hot":false}]},{"id":"472281195","root":"472281195","user":{"id":"900725","name":"⎛⎝wechen⎠⎞","avatar":"240c4647c921880120985ca8"},"text":"最开始虽然二次元了一点，但是并没有接触过虚拟主播这类的。阿苇是我接触的第一个虚拟主播，是阿苇让我知道虚拟主播可以这么有趣。那时候只有某鱼有直播，虽然对那边观感不好，但也只能追到某鱼去看。\n之后土妞这边开展了直播区，从婵苇啾陶开始，她们是vup的起点，但也凭四人之力直线拉高了vup区的质量。我永远记得那个去月球哭鼻子的苇宝，也永远记得夸夸船后真情流露的阿苇。悲欢离合都不该寄希望于来生，所以这次就遇见你很开心。[emot=acfun,1684/]\n越往后看，越觉得阿苇的知识面无比之广，而且情商高的让我自叹弗如。这个逐渐被称为疯女人，开水壶的七岁小孩，真的是太棒太棒了，她很有自己的想法，也很会独立思考。我相信她这样的人不论在哪里都可以放出万丈光芒。\n这次，不知道是否跟传言里那样有至少半年的沉默debuff，还是说要独立思考，有自己的判断。但是我还是相信阿苇也是爱我们的。所以我更希望在debuff消除之后，我们还能看到这个可以很疯，也可以很知性，见识阅历都让人惊叹的无敌棒的姑娘。到那时候，不管你外在变成什么样，我们都可以互相说一句，好久不见。[emot=acfun,1833/]","time":1627834324631,"floor":304,"likes":258,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":[],"reportedReplies":4,"hot":true,"replyPreview":[{"id":"472285653","root":"472281195","user":{"id":"900725","name":"⎛⎝wechen⎠⎞","avatar":"240c4647c921880120985ca8"},"text":"我知道虚拟偶像虚拟主播这些总有一天要说再见，但是我想象不到那一天，更想象不到这一天会这么快。\n我手里握着一百个牌子，但是除了特殊时候进直播间会换，我一直都是人传人。手头不算宽裕，也很惭愧没能支持苇宝什么，但是人传人是我手里牌子等级最高的几个之一。\n但是，任何时候都一样。任何时候，离别都会比预期来得早。即便如此，大家还是会说，再见，总有一天会再见的。再见，我们会在别处相见的。所以我，虽然离你很远很远，但还是想说，再见，总有一天我们会在别处相见的。[emot=acfun,1684/]","time":1627834892156,"floor":1,"likes":9,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":[],"reportedReplies":0,"hot":false},{"id":"472287417","root":"472281195","user":{"id":"14121903","name":"夢咚咚","avatar":"f72e2aff343ec2421948aa8f"},"text":"有一次我听到阿苇在讲“一期一会”，就觉得阿苇涉猎的真的好广，后面还有教你怎么做饭怎么过日子[emot=acfun,1672/]我……","time":1627835082066,"floor":1,"likes":8,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":[],"reportedReplies":0,"hot":false},{"id":"472317018","root":"472281195","user":{"id":"209222","name":"逝魂","avatar":"3062a26a67be1ff8d76d5e28"},"text":"同样人传人是我的第一个牌子，也是等级最高的一个牌子","time":1627837953818,"floor":1,"likes":3,"isUp":false,"replyTo":"⎛⎝wechen⎠⎞","replyToUserId":"900725","parentCommentId":null,"images":[],"reportedReplies":0,"hot":false}]},{"id":"472274811","root":"472274811","user":{"id":"945047","name":"无心⭐️睡眠","avatar":"6f63c898555257297e62b9d9"},"text":"我骑马，你吃火锅好不好啊\r\n[img=图片]https://imgs.aixifan.com/content/2021_08_01/1627833482980.gif[/img]","time":1627833485706,"floor":90,"likes":247,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":["2110468d7f7d2a6a1985e122"],"reportedReplies":1,"hot":true,"replyPreview":[{"id":"472280308","root":"472274811","user":{"id":"324650","name":"Harris .","avatar":"7ba1f3ff29fa76de295b3234"},"text":"呜呜呜呜 阿苇","time":1627834215329,"floor":1,"likes":1,"isUp":false,"replyTo":"","replyToUserId":"0","parentCommentId":null,"images":[],"reportedReplies":0,"hot":false}]},{"id":"606415567","root":"606415567","user":{"id":"12517989","name":"一只路过的浣熊","avatar":"40a896526fc712b32dab0480"},"text":"现在看第