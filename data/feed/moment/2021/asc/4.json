Count":4600,"shareCount":45},"url":"https://www.acfun.cn/v/ac24473570"},"hotComment":{"id":"392995282","user":{"id":"114806","name":"露露羞-Ri","avatar":"4a84de2fd88dcc1d6e7871c0"},"text":"找到图了\r\n[img=图片]https://imgs.aixifan.com/content/2021_02_11/1.6130131186899214E9.jpg[/img]","images":["db250a4f191424ba26583484"],"likes":20}},{"key":"moment:1072643","id":"1072643","kind":"moment","user":{"id":"179922","name":"1001Project","avatar":"c782182a37eb4562669ac9f0"},"time":1612972800000,"text":"超好听！！！","title":"","images":[],"cover":"","duration":"","views":0,"counts":{"commentCount":3,"likeCount":45,"bananaCount":43,"shareCount":0},"url":"https://m.acfun.cn/communityCircle/moment/1072643","timePrecision":"day","source":{"key":"video:24233433","id":"24233433","kind":"video","user":{"id":"2588569","name":"AcFun音乐","avatar":"c80cf0a961ecc01a6084bb04"},"time":1612977000114,"text":"","title":"【年在一起】年年黏黏年","images":[],"cover":"d6ece57e55a7d846f950c880","duration":"04:30","views":132451,"counts":{"commentCount":710,"likeCount":2854,"bananaCount":15029,"shareCount":282},"url":"https://www.acfun.cn/v/ac24233433"},"hotComment":{"id":"393003224","user":{"id":"179922","name":"1001Project","avatar":"55cb0c0a2d2740d47c6055f0"},"text":"pv也是神！","images":[],"likes":1}},{"key":"moment:1072658","id":"1072658","kind":"moment","user":{"id":"179922","name":"1001Project","avatar":"c782182a37eb4562669ac9f0"},"time":1612972800000,"text":"来了 来了 她来了！[emot=acfun,1713/][emot=acfun,1713/][emot=acfun,1713/]","title":"","images":[],"cover":"","duration":"","views":0,"counts":{"commentCount":8,"likeCount":65,"bananaCount":64,"shareCount":0},"url":"https://m.acfun.cn/communityCircle/moment/1072658","timePrecision":"day","source":{"key":"article:24506536","id":"24506536","kind":"article","user":{"id":"16005","name":"乌拉喵","avatar":"c56761775805873e414fa602"},"time":1613013912088,"text":"乌拉！乌拉！乌拉！！！大家好！我是A站练习长达十年歌姬 乌拉喵！终于出道了！（请群演掌声鼓励十分钟，叽拍叽拍叽!)2021年2月15号晚8点，大年初四陪你过年。 当晚将携手画师麻麻水姐，还有著名主持人","title":"【VUP出道】练习生时长十年歌姬“乌拉喵”出道预告！！！【初四陪你过年】","images":["5124091831d596693e8c7995","9b10c731b954d155baa11dd3","5755a7cc779ba6b08749fdcc"],"cover":"","duration":"","views":39830,"counts":{"commentCount":509,"likeCount":578,"bananaCount":3227,"shareCount":43},"url":"https://www.acfun.cn/a/ac24506536"},"hotComment":{"id":"393008079","user":{"id":"16005","name":"乌拉喵","avatar":"dcd319804ad474edfbe0e6de"},"text":"爱你！！","images":[],"likes":6}},{"key":"moment:1073168","id":"1073168","kind":"moment","user":{"id":"179922","name":"1001Project","avatar":"c782182a37eb4562669ac9f0"},"time":1612972800000,"text":"棒！辛苦啦~~//[at uid=178519]@幻想の狐[/at]：某天猴子突然找我，说我醉拳那个视频不错，想让我做一个类似的春晚视频，要求是欢乐翻车向，还要让不看v的人看懂，以DD献礼的形式呈现。这可就难整了[emot=acfun,1696/]醉拳和动物派对很合且素材统一，但现在这个素材五花八门很难统一到一起，我思来想去感觉这首《咱们屯里的人》非常贴合主题，电视剧本身的故事就是屯子里的邻里乡亲发生的种种趣事，原词也是介绍屯子和欢迎大家来屯里看看，感觉很符合a站和avi区[emot=acfun,1689/]用这首歌搭配v们的日常易懂的欢乐事，这样即使不看v的人应该也能看懂，也能起到宣传作用，这也是为什么我没选用一些带梗的素材。[emot=acfun,1683/] 最终我确立好了整体创意，然后我就开始找素材做视频，由于想加入很多v，所以光我一人找素材太慢了，于是我找了一些DD帮忙，本来想让DD做更多事的，但是猴子再三叮嘱要保密，不能让太多人知道，所以我只能瞒着DD让他们提供素材，最终断断续续弄了俩月完成了。[emot=acfun,1702/] 在这里感谢[at uid=566517]@磁暴步兵[/at] 的歌曲后期，人物抠图以及片头ac标的制作，超有梗的！ 感谢[at uid=33121836]@🍥佳佳佳佳佳🍥[/at] 以DD的身份帮我唱歌，她声音很萌，唱这首实在是挺难为她的 感谢帮忙搜集素材和提供祝福的（字母顺）[at uid=290187]@安格斯厚牛堡[/at] [at uid=484099]@安赫尔教皇的白丝裤袜[/at] [at uid=566517]@磁暴步兵[/at] @greet [at uid=0]@幻想の狐（没错我自己）[/at] [at uid=13308120]@霍香正气水[/at] [at uid=12997567]@馬鹿9[/at] [at uid=1204256]@南城老阳[/at] [at uid=386001]@sun2673568[/at] [at uid=165288]@星雨漂流[/at] [at uid=0]@有属性[/at] [at uid=0]@自断麒麟臂[/at] 由于要保密，只能瞒着你们，而且考虑到节目效果，一些DD提供的素材并没有被采用，总之抱歉。[emot=acfun,1684/]感谢上述所有人，没有你们我一个人很难完成，谢谢！[emot=acfun,1805/]最后要感谢avup们，谢谢你们带来的种种欢乐，也希望你们在新的一年里能够天天开心，收获更多关注！[emot=acfun,1797/] 这是我第一次做这么大的任务，也是第一次将这么多v加入到视频里，既激动又担心，生怕做不好，而且由于能力，时长等问题无法让所有v出现，很抱歉[emot=acfun,1800/]看了昨天的晚会，我做的视频果然和其他人比真的有很大的差距，不知道有没有让辛苦帮忙的各位失望，希望新的一年我能做出质量更高的作品吧。最后如果大家喜欢这个节目就五蕉吧，大家也可以在弹幕评论发喜欢v的名字或对她的新春祝福，让更多人看到视频，加入DD阵营吧！[emot=acfun,1797/]","title":"","images":[],"cover":"","duration":"","views":0,"counts":{"commentCount":2,"likeCount":59,"bananaCount":45,"shareCount":0},"url":"https://m.acfun.cn/communityCircle/moment/1073168","timePrecision":"day","source":{"key":"video:24471154","id":"24471154","kind":"video","user":{"id":"178519","name":"幻想の狐","avatar":"7cfb6f69f1a72382e1e423ca"},"time":1613014200167,"text":"","title":"【年在一起】咱们站里的VUP（完整DD祝福版）","images":[],"cover":"51969be0ae55c79bbc7cac20","duration":"03:12","views":41688,"counts":{"commentCount":234,"likeCount":1063,"bananaCount":5721,"shareCount":22},"url":"https://www.acfun.cn/v/ac24471154"}},{"key":"moment:1073468","id":"1073468","kind":"moment","user":{"id":"179922","name":"1001Project","avatar":"c782182a37eb4562669ac9f0"},"time":1612972800000,"text":"最后一段绝了哈哈哈哈哈哈","title":"","images":[],"cover":"","duration":"","views":0,"counts":{"commentCount":6,"likeCount":52,"bananaCount":42,"shareCount":0},"url":"https://m.acfun.cn/communityCircle/moment/1073468","timePrecision":"day","source":{"key":"video:24399573","id":"24399573","kind":"video","user":{"id":"1488068","name":"银河鲸鱼在歌唱🌌🐳🎶","avatar":"8713bf83710c00af88ad69bf"},"time":1613014200583,"text":"","title":"【年在一起】ACFUN土味模仿秀","images":[],"cover":"49c6783777a4bd2ec9e19d72","duration":"13:37","views":143290,"counts":{"commentCount":852,"likeCount":5287,"bananaCount":30114,"shareCount":761},"url":"https://www.acfun.cn/v/ac24399573"},"hotComment":{"id":"393185124","user":{"id":"270352","name":"我就是来打酱油的","avatar":"c3ea6a54ac2cd7845a885719"},"text":"猴山之虎🐯[emot=acfun,1882/][emot=acfun,1882/]","images":[],"likes":4}}],"media":{"03f0435cdaaf0c16ebb1fbdd":{"src":"https://tx-free-imgs.acfun.cn/content/2021_2_10/1.6129610382306395E9.jpeg","fallbacks":["https://tx-free-imgs2.acfun.cn/kimg/bs2/zt-image-host/ChYwOGRlY2M5NDE1MTBhZmJmZWVlYzAzEIvK1y8.jpg","https://ali-imgs.acfun.cn/kimg/bs2/zt-image-host/ChYwOGRlY2M5NDE1MTBhZmJmZWVlYzAzEIvK1y8.jpg"]},"093bb6531a9c7f8cfb23822d":{"src":"https://tx-free-imgs2.acfun.cn/bs2/acfun-image/32441245_afac01e4523c4a5abcaa892495adf402","fallbacks":["https://tx-free-